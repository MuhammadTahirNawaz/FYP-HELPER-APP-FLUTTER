rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Admin shared documents: documents/<docId>/<filename>
    // Role checks for admin uploads live in the RTDB rules layer; storage
    // requires signed-in users (tighten further with custom claims if needed).
    match /documents/{docId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Per-student uploads: student_documents/<uid>/<docId>/<filename>
    match /student_documents/{uid}/{docId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
