# Firebase Configuration (Android + Windows + Web/Chrome/Edge)
# Copy this file to .env and fill in your actual values.
# .env is in .gitignore and will not be committed.

# Android app (Firebase console -> Project settings -> Your apps -> Android)
FIREBASE_ANDROID_API_KEY=your_android_api_key_here

# Windows desktop app (Firebase console -> Add app -> Windows)
# If you already have a Web app registered, you can reuse those values temporarily:
#   FIREBASE_WINDOWS_API_KEY  = same as FIREBASE_WEB_API_KEY
#   FIREBASE_WINDOWS_APP_ID   = same as FIREBASE_WEB_APP_ID
FIREBASE_WINDOWS_API_KEY=your_windows_api_key_here
FIREBASE_WINDOWS_APP_ID=your_windows_app_id_here

# Optional legacy fallbacks (read by run_app.ps1 if Windows keys are empty)
FIREBASE_WEB_API_KEY=your_web_api_key_here
FIREBASE_WEB_APP_ID=your_web_app_id_here
